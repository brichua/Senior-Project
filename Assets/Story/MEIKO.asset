%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5dcffc070f2c7d45a208d446b2d3945, type: 3}
  m_Name: MEIKO
  m_EditorClassIdentifier: Assembly-CSharp::VocaloidTCG.StoryData
  id: story-meiko
  tutorial: 0
  storyClass: 4
  header: "World Tour Auditions — MEIKO"
  playerStarterDeck: {fileID: 11400000, guid: a3f841b9d92d4637878612bd243e7743, type: 2}
  prologue:
    lines:
    - speaker: "Narrator"
      portrait: {fileID: 0}
      text: "KAITO holds up the proposed tour promo. Almost every part of MEIKO's song is crossed out except the chorus."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "KAITO"
      portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "Good news! They love your chorus."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "MEIKO"
      portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "And the rest of the song apparently offended them."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "KAITO"
      portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "It's a fifteen-second preview."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "MEIKO"
      portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "I know. I'm not putting on a fifteen-second concert, though."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "Narrator"
      portrait: {fileID: 0}
      text: "She takes out a red pencil and circles the full set list."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
  epilogue:
    lines:
    - speaker: "Narrator"
      portrait: {fileID: 0}
      text: "MEIKO's name tops the tour poster. She checks the full opening set list while KAITO holds up his phone."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "KAITO"
      portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "The new preview's doing well. They're asking when the full version comes out."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "MEIKO"
      portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "Tonight, if everyone gets onstage on time."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "KAITO"
      portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "So... should I post the whole song afterward?"
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "MEIKO"
      portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "Sure. First, let's give them a show worth recording."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    - speaker: "Narrator"
      portrait: {fileID: 0}
      text: "She tucks the red pencil behind her ear and heads toward the stage as the house lights dim."
      avatars:
      - slot: 0
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 1
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
  auditions:
  - opponent: 0
    deckDescription: "An unfinished song, ready for an audience."
    location: "The Lantern Courtyard"
    auditionText: "An audition against Miku."
    firstClearReward: {fileID: 11400000, guid: edb40c36ed214e84bb6cfa3922067025, type: 2}
    easyDeck: {fileID: 11400000, guid: 1fb6640ce062beb46bf698583498f40d, type: 2}
    mediumDeck: {fileID: 11400000, guid: 1fb6640ce062beb46bf698583498f40d, type: 2}
    hardDeck: {fileID: 11400000, guid: 1fb6640ce062beb46bf698583498f40d, type: 2}
    before:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "MEIKO rehearses an introduction. She stops halfway through and scratches out three lines."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Wait, I liked that part!"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "The part where I explain the song before singing it?"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "...When you put it like that."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "You can tell me if you miss it after the show."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Deal! But I'm keeping my own introduction."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
    after:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "The crowd is still cheering after MEIKO's win. Miku picks up the discarded introduction sheet."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Okay, I didn't miss it."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Should I frame that sentence?"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Don't get too excited. I have notes about the second verse."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Now you're talking. Let's hear them."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "First, can I borrow that pencil?"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
  - opponent: 1
    deckDescription: "An original melody and a familiar rival."
    location: "The Rooftop Theatre"
    auditionText: "An audition against Len."
    firstClearReward: {fileID: 11400000, guid: 2c9bee9d08e838f4b8bac5071656c12a, type: 2}
    easyDeck: {fileID: 11400000, guid: d1c376575e622ba4ea509d93cd2ae101, type: 2}
    mediumDeck: {fileID: 11400000, guid: d1c376575e622ba4ea509d93cd2ae101, type: 2}
    hardDeck: {fileID: 11400000, guid: d1c376575e622ba4ea509d93cd2ae101, type: 2}
    before:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "Len tries the same high note for the fourth time. MEIKO sets a bottle of water beside him."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I can hit it. I just need one more try."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "That's what you said three tries ago."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "You've never had trouble with a note?"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Ask KAITO about my first live show. Actually, don't."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Now I definitely have to ask him."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
    after:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "MEIKO wins despite a brief crack on one high note. Len meets her backstage."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "You missed that note."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I noticed."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "But you kept going."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "The rest of the song wasn't going to sing itself."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Hah. Fair point."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
  - opponent: 2
    deckDescription: "A lively challenge from Rin."
    location: "The Tram Depot"
    auditionText: "An audition against Rin."
    firstClearReward: {fileID: 11400000, guid: 5a4ca13c112bad64190b371a46fc13d9, type: 2}
    easyDeck: {fileID: 11400000, guid: 05c75a68ffcd49039f41d5c0a3b6d766, type: 2}
    mediumDeck: {fileID: 11400000, guid: 05c75a68ffcd49039f41d5c0a3b6d766, type: 2}
    hardDeck: {fileID: 11400000, guid: 05c75a68ffcd49039f41d5c0a3b6d766, type: 2}
    before:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "Rin claps a fast beat while MEIKO adjusts her microphone."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Come on! This place needs something LOUD!"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "It was loud before you got here."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "That's a compliment, right?"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Sure. Let's see if you can make it through the slow part without speeding up."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Oh, it's a challenge now?"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    after:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "A few people call for MEIKO's quiet opening verse again. Rin looks offended on principle."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Seriously? They want the slow bit?"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "You could sing it with me."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "At that speed? I'll fall asleep!"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Then I'll wake you when it's your turn."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "...Fine. But next time, we do my version too."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
  - opponent: 3
    deckDescription: "A full song beyond a famous chorus."
    location: "The Harbor Stage"
    auditionText: "An audition against KAITO."
    firstClearReward: {fileID: 11400000, guid: 6583a1897eee0d744add7bc99a893801, type: 2}
    easyDeck: {fileID: 11400000, guid: 67abe06bb10144adb820be6c188de4b8, type: 2}
    mediumDeck: {fileID: 11400000, guid: 67abe06bb10144adb820be6c188de4b8, type: 2}
    hardDeck: {fileID: 11400000, guid: 67abe06bb10144adb820be6c188de4b8, type: 2}
    before:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "KAITO plays MEIKO a proposed fifteen-second promo clip on his phone."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "This is the version the organizers want to post."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "It cuts off in the middle of my sentence."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Technically, the middle of your verse."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Thank you, that's much better."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "...I'll take that as a no."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    after:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "KAITO shows MEIKO a recording of the audience leaning forward before her quiet verse."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Look. They all leaned in right here."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "That's where we should end the preview."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Right before the verse? That's cruel."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "They can hear the rest at the show."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "...I see what you're doing."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
  - opponent: 5
    deckDescription: "Different words for an unsigned melody."
    location: "The Planetarium"
    auditionText: "An audition against Luka."
    firstClearReward: {fileID: 11400000, guid: 2a55cd481cf55c344bbc28b64e00e025, type: 2}
    easyDeck: {fileID: 11400000, guid: 672111fe4515472988b5c2aebc23cacc, type: 2}
    mediumDeck: {fileID: 11400000, guid: 672111fe4515472988b5c2aebc23cacc, type: 2}
    hardDeck: {fileID: 11400000, guid: 672111fe4515472988b5c2aebc23cacc, type: 2}
    before:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "Luka shows MEIKO two lyric sheets with the same melody and different words."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I can't choose which verse to sing."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Why not use both?"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "One asks someone to stay. The other tells them to go."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Try them in a different order. See how they sound together."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I'll give it a try."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
    after:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "After MEIKO's win, Luka shows her an updated arrangement backstage."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I tried both verses, like you suggested."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "How'd they sound?"
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Better. I kept the pause before the second one."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "MEIKO"
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Then keep it. It's your arrangement."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I think I will."
        avatars:
        - slot: 0
          sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
