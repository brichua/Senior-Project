%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5dcffc070f2c7d45a208d446b2d3945, type: 3}
  m_Name: KagamineLen
  m_EditorClassIdentifier: Assembly-CSharp::VocaloidTCG.StoryData
  id: story-kagaminelen
  tutorial: 0
  storyClass: 1
  header: "World Tour Auditions \u2014 Len"
  playerStarterDeck: {fileID: 11400000, guid: 47039f5e15f1f61ad842d7a5167e7d96, type: 2}
  prologue:
    lines:
    - speaker: Narrator
      portrait: {fileID: 0}
      text: Len replays an old KAITO concert for the third time today.
      avatars:
      - slot: 1
        sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
      - slot: 4
        sprite: {fileID: 4151303731112465946, guid: cf77a782e36c6924199896506136f4f3, type: 3}
    - speaker: Rin
      portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: Watching it again?
      avatars:
      - slot: 1
        sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - slot: 4
        sprite: {fileID: 7355067111040609753, guid: e47f0b211c7a9ca4f9fa87c85034581c, type: 3}
    - speaker: Len
      portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: Shh. This is the best part.
      avatars:
      - slot: 1
        sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
      - slot: 4
        sprite: {fileID: 4151303731112465946, guid: cf77a782e36c6924199896506136f4f3, type: 3}
    - speaker: Rin
      portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: You say that about every song. What are you singing at the auditions?
      avatars:
      - slot: 1
        sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
      - slot: 4
        sprite: {fileID: 7355067111040609753, guid: e47f0b211c7a9ca4f9fa87c85034581c, type: 3}
    - speaker: Len
      portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: ...Still working on it.
      avatars:
      - slot: 1
        sprite: {fileID: 2109474199129327443, guid: 3464634288aedf349aea48de0f10dcdc, type: 3}
      - slot: 4
        sprite: {fileID: 4151303731112465946, guid: cf77a782e36c6924199896506136f4f3, type: 3}
  epilogue:
    lines:
    - speaker: Narrator
      portrait: {fileID: 0}
      text: Len's name tops the tour poster. In his notebook is an old KAITO concert
        ticket, covered in notes on the back.
      avatars:
      - slot: 1
        sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - slot: 4
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
    - speaker: KAITO
      portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: Ready for opening night?
      avatars:
      - slot: 1
        sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - slot: 4
        sprite: {fileID: 6506257976614099797, guid: e953fd9f6a3a3334884fede5ea8b3148, type: 3}
    - speaker: Len
      portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: Yeah. I've got the first song picked out.
      avatars:
      - slot: 1
        sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
      - slot: 4
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
    - speaker: KAITO
      portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: Oh? Which one?
      avatars:
      - slot: 1
        sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
      - slot: 4
        sprite: {fileID: 6506257976614099797, guid: e953fd9f6a3a3334884fede5ea8b3148, type: 3}
    - speaker: Len
      portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: Mine. Lights Left On. You'll sing the second verse, right?
      avatars:
      - slot: 1
        sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
      - slot: 4
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
    - speaker: KAITO
      portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: If you teach it to me!
      avatars:
      - slot: 1
        sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
      - slot: 4
        sprite: {fileID: 4067148055806570340, guid: 63bc681a22b302b4697f4c06ebb49c41, type: 3}
    - speaker: Len
      portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: Just try to keep up.
      avatars:
      - slot: 1
        sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
      - slot: 4
        sprite: {fileID: -6317423667150299997, guid: 93cb99591fd4be445b3887ccb01be9a0, type: 3}
    - speaker: Narrator
      portrait: {fileID: 0}
      text: Len laughs and heads toward the stage, with KAITO following him.
      avatars:
      - slot: 1
        sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - slot: 4
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
  auditions:
  - opponent: 0
    deckDescription: Miku strengthens nearby allies and shares influence to build
      a powerful group of performers.
    location: The Lantern Courtyard
    auditionText: An audition against Miku.
    firstClearReward: {fileID: 11400000, guid: 9ec1e18bd838c0249b047995f3eff601, type: 2}
    easyDeck: {fileID: 11400000, guid: 2c3ebb934c6964f3099f5bca55ebf727, type: 2}
    mediumDeck: {fileID: 11400000, guid: e25a40858a935d10bde6f93df11bc4d9, type: 2}
    hardDeck: {fileID: 11400000, guid: 1e660b9fdcb991ade24445970dfdd6ed, type: 2}
    before:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: Miku catches Len practicing KAITO's chorus near the courtyard stage.
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Isn't that KAITO's song?
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: -6467469513183496125, guid: 64258669bcda46446a650c15765c381a, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: You recognized it that fast?!
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: -434653091246056264, guid: ad033b83d33c6dc45a9d86abcdcc004c, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: You've been humming it all morning.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: -6467469513183496125, guid: 64258669bcda46446a650c15765c381a, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: It's a warm-up. I've got my own song too!
        avatars:
        - slot: 1
          sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
        - slot: 4
          sprite: {fileID: 4311828083851245686, guid: 0ed4ac1d21af8974a8e3b903b5a7c0c3, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Then let's hear it!
        avatars:
        - slot: 1
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
        - slot: 4
          sprite: {fileID: 5531041605552728420, guid: 8a62fd28134ed2841aa676a65b561ae9, type: 3}
    after:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: People near the food stalls are humming a melody from Len's winning
          performance.
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Hear that? They're singing your chorus!
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: 5531041605552728420, guid: 8a62fd28134ed2841aa676a65b561ae9, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Wait. My chorus?
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: 531467281934478826, guid: b5204f013456e4745a67aceb894cb700, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: It's catchy. I nearly joined in myself.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: -5784461528446217249, guid: 0d1a9c5c749493e4db30ed7310bc43ef, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Then next time, you should.
        avatars:
        - slot: 1
          sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
        - slot: 4
          sprite: {fileID: -434653091246056264, guid: ad033b83d33c6dc45a9d86abcdcc004c, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Deal! You'll have to teach me the words.
        avatars:
        - slot: 1
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
        - slot: 4
          sprite: {fileID: 5531041605552728420, guid: 8a62fd28134ed2841aa676a65b561ae9, type: 3}
  - opponent: 2
    deckDescription: Rin creates tokens and turns discards and performers leaving
      the stage into bonuses.
    location: The Tram Depot
    auditionText: An audition against Rin.
    firstClearReward: {fileID: 11400000, guid: 8f1a72e0ef7465a42bff6be3048b71fe, type: 2}
    easyDeck: {fileID: 11400000, guid: 0aa8f72f3a952f6ff9caeb6930ca41e8, type: 2}
    mediumDeck: {fileID: 11400000, guid: bad97a986d7fb1382273766afced01f8, type: 2}
    hardDeck: {fileID: 11400000, guid: a10f728ff1af456731f0eb0cfb8904fa, type: 2}
    before:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: Rin stops rehearsing when Len changes the rhythm without warning.
        avatars:
        - slot: 1
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
        - slot: 4
          sprite: {fileID: 8466827584194706362, guid: 91240b5a94dd0f54e905a9904b43083c, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Hey! That's not the count!
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: 6138499018571659458, guid: 9890fb00517102f4589d9d41eb6c2ce2, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: It is now.
        avatars:
        - slot: 1
          sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
        - slot: 4
          sprite: {fileID: 8466827584194706362, guid: 91240b5a94dd0f54e905a9904b43083c, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: You could've warned me!
        avatars:
        - slot: 1
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
        - slot: 4
          sprite: {fileID: 6138499018571659458, guid: 9890fb00517102f4589d9d41eb6c2ce2, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: What, can't keep up?
        avatars:
        - slot: 1
          sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
        - slot: 4
          sprite: {fileID: 8466827584194706362, guid: 91240b5a94dd0f54e905a9904b43083c, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Just watch me.
        avatars:
        - slot: 1
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
        - slot: 4
          sprite: {fileID: -5737405312357465230, guid: 25b3083561c08624e8c1142bcd67678c, type: 3}
    after:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: Rin is still tapping the rhythm Len used in their final round.
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: 4151303731112465946, guid: cf77a782e36c6924199896506136f4f3, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: That pause was so annoying.
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: 6138499018571659458, guid: 9890fb00517102f4589d9d41eb6c2ce2, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: You liked it.
        avatars:
        - slot: 1
          sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
        - slot: 4
          sprite: {fileID: 8466827584194706362, guid: 91240b5a94dd0f54e905a9904b43083c, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: I did not!
        avatars:
        - slot: 1
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
        - slot: 4
          sprite: {fileID: 6138499018571659458, guid: 9890fb00517102f4589d9d41eb6c2ce2, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: You're tapping it right now.
        avatars:
        - slot: 1
          sprite: {fileID: -6252771093854531909, guid: d8ae485ba1dc9cd47832f3126448021c, type: 3}
        - slot: 4
          sprite: {fileID: 8466827584194706362, guid: 91240b5a94dd0f54e905a9904b43083c, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: So I can beat it next time!
        avatars:
        - slot: 1
          sprite: {fileID: -2751635966877528251, guid: a2cfee1425dd86647be4673307bc7f1b, type: 3}
        - slot: 4
          sprite: {fileID: -5737405312357465230, guid: 25b3083561c08624e8c1142bcd67678c, type: 3}
  - opponent: 3
    deckDescription: Kaito moves performers around the stage and rewards allies for
      spreading across columns.
    location: The Harbor Stage
    auditionText: An audition against KAITO.
    firstClearReward: {fileID: 11400000, guid: a93b4abb8c7e93f48be77cf8a70f6cd6, type: 2}
    easyDeck: {fileID: 11400000, guid: e3b30fb588f79c49aed6fc243283b8b7, type: 2}
    mediumDeck: {fileID: 11400000, guid: ed6cee514bf29a43372c939ab3da0f18, type: 2}
    hardDeck: {fileID: 11400000, guid: f63d3f6c9481491c655759b698f5b58a, type: 2}
    before:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: KAITO notices an old concert ticket sticking out of Len's notebook.
        avatars:
        - slot: 1
          sprite: {fileID: -7316959908947235806, guid: cdbe4e0629394454fb7d1830a6b440d8, type: 3}
        - slot: 4
          sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: You were at that show? The wind took my set list halfway through!
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: 6526448974759205420, guid: 34e291faf589f6348b04fb7f63ff288c, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Wait. That long pause wasn't planned?
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: 3342472002854934847, guid: bb9fbdd48b2c8d14886a01142a8417df, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: I was waiting for someone to bring it back.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: 6149762242164147661, guid: c3005a6e00678e3419d81925b5c2da6a, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: I thought you were building suspense!
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: 3342472002854934847, guid: bb9fbdd48b2c8d14886a01142a8417df, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: ...Can we keep that between us?
        avatars:
        - slot: 1
          sprite: {fileID: -2751635966877528251, guid: a2cfee1425dd86647be4673307bc7f1b, type: 3}
        - slot: 4
          sprite: {fileID: 6149762242164147661, guid: c3005a6e00678e3419d81925b5c2da6a, type: 3}
    after:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: Len checks the results twice. KAITO holds out his hand.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: -6317423667150299997, guid: 93cb99591fd4be445b3887ccb01be9a0, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: I really won? You didn't go easy on me?
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Not a bit. That last chorus almost got away from me.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: 4067148055806570340, guid: 63bc681a22b302b4697f4c06ebb49c41, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: I used to practice your songs every day.
        avatars:
        - slot: 1
          sprite: {fileID: 3078092795626919404, guid: ab92f6b78dac17343bb3f0a9c6589283, type: 3}
        - slot: 4
          sprite: {fileID: -6317423667150299997, guid: 93cb99591fd4be445b3887ccb01be9a0, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Then it's about time I practiced one of yours.
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: 4067148055806570340, guid: 63bc681a22b302b4697f4c06ebb49c41, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Heh. I've got a new one for you.
        avatars:
        - slot: 1
          sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
        - slot: 4
          sprite: {fileID: -6317423667150299997, guid: 93cb99591fd4be445b3887ccb01be9a0, type: 3}
  - opponent: 4
    deckDescription: Meiko creates new cards and shares keywords to strengthen her
      performers.
    location: The Converted Cinema
    auditionText: An audition against MEIKO.
    firstClearReward: {fileID: 11400000, guid: 54acff21c2ab5c446ab78542699ad8b9, type: 2}
    easyDeck: {fileID: 11400000, guid: 066951dfb2fabf738bf0d86706f3ce72, type: 2}
    mediumDeck: {fileID: 11400000, guid: 667cedfedc6bc5f803e6556c38c79a7f, type: 2}
    hardDeck: {fileID: 11400000, guid: 25f74ba3e4be98bdaac0713570db66b4, type: 2}
    before:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: Len finishes rehearsing a high note. MEIKO looks up from her set list.
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: 1025957635999731651, guid: e299bec22c3e3b04ca06e0001ac7ca64, type: 3}
      - speaker: MEIKO
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Nice note. What happened to the verse before it?
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: -5909369726638379594, guid: 15b288373541ce745b2a4fc354c46beb, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: I cut it. It's about missing the last train. Not exactly exciting.
        avatars:
        - slot: 1
          sprite: {fileID: 2109474199129327443, guid: 3464634288aedf349aea48de0f10dcdc, type: 3}
        - slot: 4
          sprite: {fileID: 1025957635999731651, guid: e299bec22c3e3b04ca06e0001ac7ca64, type: 3}
      - speaker: MEIKO
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Hah. KAITO and I did that once.
        avatars:
        - slot: 1
          sprite: {fileID: 7674018612228396797, guid: 87a8d465a23a180429198277114a8403, type: 3}
        - slot: 4
          sprite: {fileID: 1521368860836332526, guid: 18538c62a586e8e40880ac3a43b0ccca, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Really? What happened?
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: 8756508170796686454, guid: d93bc75ba5d83d14f859334df5b225e0, type: 3}
      - speaker: MEIKO
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Long story. Sing me that verse first.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: 659807028895115265, guid: d5deaaf6772957344b6b32b1640b27d3, type: 3}
    after:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: Len keeps the verse about missing the train in his winning performance.
        avatars:
        - slot: 1
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
        - slot: 4
          sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: I thought everyone would get bored during that part.
        avatars:
        - slot: 1
          sprite: {fileID: 2109474199129327443, guid: 3464634288aedf349aea48de0f10dcdc, type: 3}
        - slot: 4
          sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - speaker: MEIKO
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Did you see the guy in the front row? He laughed at the last line.
        avatars:
        - slot: 1
          sprite: {fileID: 7674018612228396797, guid: 87a8d465a23a180429198277114a8403, type: 3}
        - slot: 4
          sprite: {fileID: 1521368860836332526, guid: 18538c62a586e8e40880ac3a43b0ccca, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Really? I nearly cut the whole verse.
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: 8756508170796686454, guid: d93bc75ba5d83d14f859334df5b225e0, type: 3}
      - speaker: MEIKO
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Good thing you didn't.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: 1521368860836332526, guid: 18538c62a586e8e40880ac3a43b0ccca, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: I'm keeping the high note too, just saying.
        avatars:
        - slot: 1
          sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
        - slot: 4
          sprite: {fileID: 8756508170796686454, guid: d93bc75ba5d83d14f859334df5b225e0, type: 3}
  - opponent: 5
    deckDescription: Luka contests Center Stage and builds audience score to unlock
      discounts and stronger buffs.
    location: The Planetarium
    auditionText: An audition against Luka.
    firstClearReward: {fileID: 11400000, guid: d489ad287d3ecdf46b555c7bf83ee5d7, type: 2}
    easyDeck: {fileID: 11400000, guid: ceb93133aa9561c6a872dab0cfa2c39e, type: 2}
    mediumDeck: {fileID: 11400000, guid: f4b2837e43d5e0cbd469618d517077ef, type: 2}
    hardDeck: {fileID: 11400000, guid: f1256f254a989b509dcc07792658e523, type: 2}
    before:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: Luka plays an unsigned melody. Len stops to listen.
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: 5076353916888053700, guid: 76bcca590ddfebc49b7f79afec057bfc, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Huh. Never heard this one. Who's it by?
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
      - speaker: Luka
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: That's what I'm trying to find out.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: 2541232186797710645, guid: 8c2198f91143d7040ab0170e51459e2c, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Really? You don't know?
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: 5076353916888053700, guid: 76bcca590ddfebc49b7f79afec057bfc, type: 3}
      - speaker: Luka
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: I know how it goes. That's a start.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: 848881099071188197, guid: 991781bd03c8bb64192e8c3d64485d96, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Play the chorus again? I like that bit.
        avatars:
        - slot: 1
          sprite: {fileID: 7223590954562643371, guid: 443d92ae47d239f4fbd9198ba873d265, type: 3}
        - slot: 4
          sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
    after:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        text: Luka listens as Len stops halfway through a melody of his own.
        avatars:
        - slot: 1
          sprite: {fileID: 7674018612228396797, guid: 87a8d465a23a180429198277114a8403, type: 3}
        - slot: 4
          sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
      - speaker: Luka
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: You changed the ending.
        avatars:
        - slot: 1
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
        - slot: 4
          sprite: {fileID: 848881099071188197, guid: 991781bd03c8bb64192e8c3d64485d96, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Twice. Neither version sounds right.
        avatars:
        - slot: 1
          sprite: {fileID: 2109474199129327443, guid: 3464634288aedf349aea48de0f10dcdc, type: 3}
        - slot: 4
          sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
      - speaker: Luka
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Try ending it a beat earlier.
        avatars:
        - slot: 1
          sprite: {fileID: 7674018612228396797, guid: 87a8d465a23a180429198277114a8403, type: 3}
        - slot: 4
          sprite: {fileID: 2541232186797710645, guid: 8c2198f91143d7040ab0170e51459e2c, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Won't it sound unfinished?
        avatars:
        - slot: 1
          sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
        - slot: 4
          sprite: {fileID: 5076353916888053700, guid: 76bcca590ddfebc49b7f79afec057bfc, type: 3}
      - speaker: Luka
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: Play it once and see.
        avatars:
        - slot: 1
          sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
        - slot: 4
          sprite: {fileID: 848881099071188197, guid: 991781bd03c8bb64192e8c3d64485d96, type: 3}
