  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5dcffc070f2c7d45a208d446b2d3945, type: 3}
  m_Name: HatsuneMiku
  m_EditorClassIdentifier: Assembly-CSharp::VocaloidTCG.StoryData
  id: story-hatsunemiku
  tutorial: 0
  storyClass: 0
  header: "World Tour Auditions \u2014 Miku"
  playerStarterDeck: {fileID: 11400000, guid: e18f2953280683638d63d0909bf206da, type: 2}
  prologue:
    lines:
    - speaker: Narrator
      portrait: {fileID: 0}
      voiceline: {fileID: 8300000, guid: caacf738306f3f243a0a7b5c1e66e5b9, type: 3}
      text: A tour audition notice sits beside Miku's open notebook. The chorus on
        the page has been crossed out twice.
      avatars:
      - slot: 2
        sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
    - speaker: Miku
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 8300000, guid: 374b13b4db0a46947902846eacef7418, type: 3}
      text: Hmm. Nope. Still doesn't sound right.
      avatars:
      - slot: 2
        sprite: {fileID: 4311828083851245686, guid: 0ed4ac1d21af8974a8e3b903b5a7c0c3, type: 3}
    - speaker: Miku
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 0}
      text: Maybe if I move the chorus up...
      avatars:
      - slot: 2
        sprite: {fileID: 4311828083851245686, guid: 0ed4ac1d21af8974a8e3b903b5a7c0c3, type: 3}
    - speaker: Narrator
      portrait: {fileID: 0}
      voiceline: {fileID: 8300000, guid: 8b3591e1ea617394397e88d59025c1fc, type: 3}
      text: Her phone buzzes with another reminder about the auditions.
      avatars:
      - slot: 2
        sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
    - speaker: Miku
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 0}
      text: I know, I know! I'm entering!
      avatars:
      - slot: 2
        sprite: {fileID: 531467281934478826, guid: b5204f013456e4745a67aceb894cb700, type: 3}
    - speaker: Miku
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 8300000, guid: 491d31549390eaa4a9913dee887bb83f, type: 3}
      text: ...Just as soon as I figure out what I'm singing.
      avatars:
      - slot: 2
        sprite: {fileID: -6467469513183496125, guid: 64258669bcda46446a650c15765c381a, type: 3}
  epilogue:
    lines:
    - speaker: Narrator
      portrait: {fileID: 0}
      voiceline: {fileID: 0}
      text: The final audition results name Miku as headliner. Her notebook is open
        to a finished song.
      avatars:
      - slot: 0
        sprite: {fileID: -684920494851344184, guid: 7ee112923e10d07458213117a01dafaa, type: 3}
      - slot: 1
        sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
      - slot: 2
        sprite: {fileID: 1008211201124965473, guid: 430621e623a778b47bc4f779618698db, type: 3}
      - slot: 3
        sprite: {fileID: 3726713837962234875, guid: 1e5c86882b65c85449ca8dfa842f3d59, type: 3}
      - slot: 4
        sprite: {fileID: 2548522690004552740, guid: e6534b77d828d09428b757174e8ed8be, type: 3}
      - slot: 5
        sprite: {fileID: 6715473294404108231, guid: 069d8e614ff810841859dfece9b8d3bb, type: 3}
    - speaker: Rin
      portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 8300000, guid: 55f3890a0805e5542bd117ecb6d5c863, type: 3}
      text: So, what's the first song?
      avatars:
      - slot: 0
        sprite: {fileID: -684920494851344184, guid: 7ee112923e10d07458213117a01dafaa, type: 3}
      - slot: 1
        sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - slot: 2
        sprite: {fileID: 4240592442303869473, guid: 0e21096ae5539de42a941bbc73c11697, type: 3}
      - slot: 3
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
      - slot: 4
        sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - slot: 5
        sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
    - speaker: Miku
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 0}
      text: I was hoping we could all do it together.
      avatars:
      - slot: 0
        sprite: {fileID: 5531041605552728420, guid: 8a62fd28134ed2841aa676a65b561ae9, type: 3}
      - slot: 1
        sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - slot: 2
        sprite: {fileID: -6669168746909621162, guid: 0e83925bdc271a642a541badaf0fbd37, type: 3}
      - slot: 3
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
      - slot: 4
        sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - slot: 5
        sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
    - speaker: Len
      portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 8300000, guid: be478c6322f802a4ea4dabcf75b598bc, type: 3}
      text: All six of us? You could've asked first!
      avatars:
      - slot: 0
        sprite: {fileID: -434653091246056264, guid: ad033b83d33c6dc45a9d86abcdcc004c, type: 3}
      - slot: 1
        sprite: {fileID: -8751352758729138934, guid: d741e82c80bfba94dab9c3062b8c8110, type: 3}
      - slot: 2
        sprite: {fileID: -6891413683278241132, guid: 0561decc7a86c4d42b17bcc8fbdc96f7, type: 3}
      - slot: 3
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
      - slot: 4
        sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - slot: 5
        sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
    - speaker: Miku
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 0}
      text: I'm asking now!
      avatars:
      - slot: 0
        sprite: {fileID: -5784461528446217249, guid: 0d1a9c5c749493e4db30ed7310bc43ef, type: 3}
      - slot: 1
        sprite: {fileID: -8936150323484664188, guid: 606b73881be89c5458cf32485a5a036b, type: 3}
      - slot: 2
        sprite: {fileID: -6669168746909621162, guid: 0e83925bdc271a642a541badaf0fbd37, type: 3}
      - slot: 3
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
      - slot: 4
        sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - slot: 5
        sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
    - speaker: MEIKO
      portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 0}
      text: You already wrote the parts, didn't you?
      avatars:
      - slot: 0
        sprite: {fileID: -434653091246056264, guid: ad033b83d33c6dc45a9d86abcdcc004c, type: 3}
      - slot: 1
        sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - slot: 2
        sprite: {fileID: -6669168746909621162, guid: 0e83925bdc271a642a541badaf0fbd37, type: 3}
      - slot: 3
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
      - slot: 4
        sprite: {fileID: -5909369726638379594, guid: 15b288373541ce745b2a4fc354c46beb, type: 3}
      - slot: 5
        sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
    - speaker: Miku
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      voiceline: {fileID: 8300000, guid: 374b13b4db0a46947902846eacef7418, type: 3}
      text: ...Maybe a few.
      avatars:
      - slot: 0
        sprite: {fileID: -6467469513183496125, guid: 64258669bcda46446a650c15765c381a, type: 3}
      - slot: 1
        sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - slot: 2
        sprite: {fileID: -6669168746909621162, guid: 0e83925bdc271a642a541badaf0fbd37, type: 3}
      - slot: 3
        sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
      - slot: 4
        sprite: {fileID: 8756508170796686454, guid: d93bc75ba5d83d14f859334df5b225e0, type: 3}
      - slot: 5
        sprite: {fileID: 5296954397734636559, guid: 88015ca618f77154aaacf58d9c875728, type: 3}
    - speaker: Narrator
      portrait: {fileID: 0}
      voiceline: {fileID: 8300000, guid: f4d6d8204c93cb84f956e439d8012fb8, type: 3}
      text: She turns the notebook around. Six names are written beside the first
        verse.
      avatars:
      - slot: 0
        sprite: {fileID: -434653091246056264, guid: ad033b83d33c6dc45a9d86abcdcc004c, type: 3}
      - slot: 1
        sprite: {fileID: -2751635966877528251, guid: a2cfee1425dd86647be4673307bc7f1b, type: 3}
      - slot: 2
        sprite: {fileID: -6891413683278241132, guid: 0561decc7a86c4d42b17bcc8fbdc96f7, type: 3}
      - slot: 3
        sprite: {fileID: -6317423667150299997, guid: 93cb99591fd4be445b3887ccb01be9a0, type: 3}
      - slot: 4
        sprite: {fileID: 8756508170796686454, guid: d93bc75ba5d83d14f859334df5b225e0, type: 3}
      - slot: 5
        sprite: {fileID: -7160719286429738108, guid: 041fa33cda16c7044aeada8e9029e9e9, type: 3}
  auditions:
  - opponent: 1
    deckDescription: Len weakens and removes opposing performers to control Center
      Stage.
    location: The Rooftop Theatre
    auditionText: An audition against Len.
    firstClearReward: {fileID: 11400000, guid: f8d69254569899342b3016e713eac2ac, type: 2}
    easyDeck: {fileID: 11400000, guid: 2d8ba78264a734a6f9b87166143f8fff, type: 2}
    mediumDeck: {fileID: 11400000, guid: b4189a5eb614f2b7b3b516155fa0906e, type: 2}
    hardDeck: {fileID: 11400000, guid: 037327c14cbdf792dec514f0cc1dd2b3, type: 2}
    before:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        voiceline: {fileID: 8300000, guid: f4cfad05acbcb784785667e03666e0c4, type: 3}
        text: Len is checking the sound on the rooftop stage. A KAITO concert ticket
          sticks out of his notebook.
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: You've got that ticket with you again?
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: It's good luck!
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: -2751635966877528251, guid: a2cfee1425dd86647be4673307bc7f1b, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 6d3a5bc610201eb478a2254bfd3ac559, type: 3}
        text: Does it work for auditions?
        avatars:
        - slot: 1
          sprite: {fileID: 531467281934478826, guid: b5204f013456e4745a67aceb894cb700, type: 3}
        - slot: 4
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: cdff2d0fa35c0d04ca309c8793721879, type: 3}
        text: Guess we're about to find out.
        avatars:
        - slot: 1
          sprite: {fileID: 1414087313690171253, guid: bd2e8b9a35e8b5740a210eeda43ff22c, type: 3}
        - slot: 4
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: a707dd6f88987884ead8de2a3d432588, type: 3}
        text: Hey, save some luck for me!
        avatars:
        - slot: 1
          sprite: {fileID: 1414087313690171253, guid: bd2e8b9a35e8b5740a210eeda43ff22c, type: 3}
        - slot: 4
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
    after:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        voiceline: {fileID: 8300000, guid: 50b7ae3544a7d004996c51e7f7eb54a6, type: 3}
        text: Len keeps humming a phrase as he unplugs his microphone.
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: Was that in your song? I don't remember it.
        avatars:
        - slot: 1
          sprite: {fileID: -2199009814668414564, guid: 25eb3c64c8a9d4e4dbac7f14ab53122f, type: 3}
        - slot: 4
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: Made it up just now.
        avatars:
        - slot: 1
          sprite: {fileID: 1414087313690171253, guid: bd2e8b9a35e8b5740a210eeda43ff22c, type: 3}
        - slot: 4
          sprite: {fileID: 8693415673057005869, guid: 9ef075f479c895643b7036e2307c9a93, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 8422fad6a39eec94b996e1834c64cf92, type: 3}
        text: Can you sing it again? I liked it!
        avatars:
        - slot: 1
          sprite: {fileID: 5531041605552728420, guid: 8a62fd28134ed2841aa676a65b561ae9, type: 3}
        - slot: 4
          sprite: {fileID: -956189301214819756, guid: 50d2a575c6258d946bf3eab369844e1a, type: 3}
      - speaker: Len
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: d3c818ee27455fb43a2ad8d607c2241a, type: 3}
        text: Sure. But I'm writing it down first.
        avatars:
        - slot: 1
          sprite: {fileID: 531467281934478826, guid: b5204f013456e4745a67aceb894cb700, type: 3}
        - slot: 4
          sprite: {fileID: 3078092795626919404, guid: ab92f6b78dac17343bb3f0a9c6589283, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: Fair. It's already stuck in my head.
        avatars:
        - slot: 1
          sprite: {fileID: -5784461528446217249, guid: 0d1a9c5c749493e4db30ed7310bc43ef, type: 3}
        - slot: 4
          sprite: {fileID: 1275116586176032080, guid: 715a83d076871134280f70cb8c7d6033, type: 3}
  - opponent: 2
    deckDescription: Rin creates tokens and turns discards and performers leaving
      the stage into bonuses.
    location: The Tram Depot
    auditionText: An audition against Rin.
    firstClearReward: {fileID: 11400000, guid: 6631ca9c73572a94cb689374408e2cba, type: 2}
    easyDeck: {fileID: 11400000, guid: 0aa8f72f3a952f6ff9caeb6930ca41e8, type: 2}
    mediumDeck: {fileID: 11400000, guid: bad97a986d7fb1382273766afced01f8, type: 2}
    hardDeck: {fileID: 11400000, guid: a10f728ff1af456731f0eb0cfb8904fa, type: 2}
    before:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        voiceline: {fileID: 8300000, guid: f4cfad05acbcb784785667e03666e0c4, type: 3}
        text: Rin is testing the speakers at the old tram depot. The bass rattles
          the railing.
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: 7315369456398821115, guid: caa699f698d4b75498d9700e26408b49, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: Miku! You're up next. Hope you brought something good!
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: -8036308041886742708, guid: 9c688388a046dd24dbbc30ee2987acc9, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: I did. Mostly.
        avatars:
        - slot: 1
          sprite: {fileID: -6467469513183496125, guid: 64258669bcda46446a650c15765c381a, type: 3}
        - slot: 4
          sprite: {fileID: 7315369456398821115, guid: caa699f698d4b75498d9700e26408b49, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: da046eee1d715734e955c7a375ebed5c, type: 3}
        text: Mostly?
        avatars:
        - slot: 1
          sprite: {fileID: 4311828083851245686, guid: 0ed4ac1d21af8974a8e3b903b5a7c0c3, type: 3}
        - slot: 4
          sprite: {fileID: -6891710502897521986, guid: c688d2633af154e4b9f2194e663a7494, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 9c288ec4cad502644a948c55f0fc0896, type: 3}
        text: I'm still deciding on the ending.
        avatars:
        - slot: 1
          sprite: {fileID: -6467469513183496125, guid: 64258669bcda46446a650c15765c381a, type: 3}
        - slot: 4
          sprite: {fileID: -6498270370585485129, guid: 6a005da741980b346901fdcc3c26ab52, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: e9bc8afb724b1af4e91b00a60107c213, type: 3}
        text: Then you'd better decide fast. I'm not going easy on you!
        avatars:
        - slot: 1
          sprite: {fileID: 4311828083851245686, guid: 0ed4ac1d21af8974a8e3b903b5a7c0c3, type: 3}
        - slot: 4
          sprite: {fileID: -5737405312357465230, guid: 25b3083561c08624e8c1142bcd67678c, type: 3}
    after:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        voiceline: {fileID: 8300000, guid: 914587616647f6344848c0c2860e75d2, type: 3}
        text: The crowd starts clapping the rhythm from Miku's final chorus. Rin
          joins in before noticing.
        avatars:
        - slot: 1
          sprite: {fileID: -434653091246056264, guid: ad033b83d33c6dc45a9d86abcdcc004c, type: 3}
        - slot: 4
          sprite: {fileID: -6891413683278241132, guid: 0561decc7a86c4d42b17bcc8fbdc96f7, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: ebea650ba54e39342a2907330c193e29, type: 3}
        text: Ah! You're doing it too!
        avatars:
        - slot: 1
          sprite: {fileID: 5531041605552728420, guid: 8a62fd28134ed2841aa676a65b561ae9, type: 3}
        - slot: 4
          sprite: {fileID: -6669168746909621162, guid: 0e83925bdc271a642a541badaf0fbd37, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: It's stuck in my head. That's not a compliment.
        avatars:
        - slot: 1
          sprite: {fileID: -684920494851344184, guid: 7ee112923e10d07458213117a01dafaa, type: 3}
        - slot: 4
          sprite: {fileID: 6138499018571659458, guid: 9890fb00517102f4589d9d41eb6c2ce2, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: bdece2fc8ba803b4c867ad555238b938, type: 3}
        text: Then why are you still clapping?
        avatars:
        - slot: 1
          sprite: {fileID: -5258151446683417647, guid: 4245179bb379a974db70dad1373c8ed0, type: 3}
        - slot: 4
          sprite: {fileID: 8466827584194706362, guid: 91240b5a94dd0f54e905a9904b43083c, type: 3}
      - speaker: Rin
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: ffd1ee006714dda43a8db32373b47288, type: 3}
        text: Next time, I'm bringing a chorus you can't get rid of.
        avatars:
        - slot: 1
          sprite: {fileID: -684920494851344184, guid: 7ee112923e10d07458213117a01dafaa, type: 3}
        - slot: 4
          sprite: {fileID: -5737405312357465230, guid: 25b3083561c08624e8c1142bcd67678c, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: I'll look forward to it!
        avatars:
        - slot: 1
          sprite: {fileID: -5784461528446217249, guid: 0d1a9c5c749493e4db30ed7310bc43ef, type: 3}
        - slot: 4
          sprite: {fileID: 1008211201124965473, guid: 430621e623a778b47bc4f779618698db, type: 3}
  - opponent: 3
    deckDescription: Kaito moves performers around the stage and rewards allies for
      spreading across columns.
    location: The Harbor Stage
    auditionText: An audition against KAITO.
    firstClearReward: {fileID: 11400000, guid: 092135c832b21ae4db09f80496e9eecb, type: 2}
    easyDeck: {fileID: 11400000, guid: e3b30fb588f79c49aed6fc243283b8b7, type: 2}
    mediumDeck: {fileID: 11400000, guid: ed6cee514bf29a43372c939ab3da0f18, type: 2}
    hardDeck: {fileID: 11400000, guid: f63d3f6c9481491c655759b698f5b58a, type: 2}
    before:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        voiceline: {fileID: 0}
        text: KAITO is waving at the camera set up by the harbor stage. Its indicator
          light is still off.
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: -6317423667150299997, guid: 93cb99591fd4be445b3887ccb01be9a0, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 374b13b4db0a46947902846eacef7418, type: 3}
        text: KAITO, you're not live yet.
        avatars:
        - slot: 1
          sprite: {fileID: -6467469513183496125, guid: 64258669bcda46446a650c15765c381a, type: 3}
        - slot: 4
          sprite: {fileID: 3997827281134827966, guid: 4dd0976292bb9044fa8be6053c057a52, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 4faa01b6846ea3f4c8ad3c6cd2bb8456, type: 3}
        text: Ah. That explains why nobody's waving back.
        avatars:
        - slot: 1
          sprite: {fileID: -434653091246056264, guid: ad033b83d33c6dc45a9d86abcdcc004c, type: 3}
        - slot: 4
          sprite: {fileID: -1971943863084206274, guid: 0bca34c626aa4694aaf31971b87bd402, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: You could wave at the people right in front of you.
        avatars:
        - slot: 1
          sprite: {fileID: -5784461528446217249, guid: 0d1a9c5c749493e4db30ed7310bc43ef, type: 3}
        - slot: 4
          sprite: {fileID: -7753276395421877545, guid: 710cc76e5bee0ef47a514d68f1f7b013, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 56344e76f71ed544dacf9a98c693f18e, type: 3}
        text: You're right! Hello, everyone!
        avatars:
        - slot: 1
          sprite: {fileID: -434653091246056264, guid: ad033b83d33c6dc45a9d86abcdcc004c, type: 3}
        - slot: 4
          sprite: {fileID: 6526448974759205420, guid: 34e291faf589f6348b04fb7f63ff288c, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: Haha! Save some energy for our match!
        avatars:
        - slot: 1
          sprite: {fileID: -5784461528446217249, guid: 0d1a9c5c749493e4db30ed7310bc43ef, type: 3}
        - slot: 4
          sprite: {fileID: 5903908461516492951, guid: 8c8bebc2cb7e56f4c971ca55f27f8852, type: 3}
    after:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        voiceline: {fileID: 0}
        text: The broadcast ends, but someone beyond the harbor fence is still singing
          KAITO's chorus.
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: 5903908461516492951, guid: 8c8bebc2cb7e56f4c971ca55f27f8852, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: a59bc86f29d52704abf931ea80533273, type: 3}
        text: Oh! He stayed for the whole show.
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: 6526448974759205420, guid: 34e291faf589f6348b04fb7f63ff288c, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: And he's singing your chorus! I worked hard on mine, too.
        avatars:
        - slot: 1
          sprite: {fileID: 954787963642399000, guid: c3b010e893f41c4459071fb3aefecd76, type: 3}
        - slot: 4
          sprite: {fileID: 5903908461516492951, guid: 8c8bebc2cb7e56f4c971ca55f27f8852, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: Want to try yours together?
        avatars:
        - slot: 1
          sprite: {fileID: 3779046242575419312, guid: 10a7f3ad867138144ab8d57095dd6539, type: 3}
        - slot: 4
          sprite: {fileID: 4067148055806570340, guid: 63bc681a22b302b4697f4c06ebb49c41, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: ebea650ba54e39342a2907330c193e29, type: 3}
        text: Really?
        avatars:
        - slot: 1
          sprite: {fileID: -2199009814668414564, guid: 25eb3c64c8a9d4e4dbac7f14ab53122f, type: 3}
        - slot: 4
          sprite: {fileID: -6317423667150299997, guid: 93cb99591fd4be445b3887ccb01be9a0, type: 3}
      - speaker: KAITO
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 650f7dbd0a116eb4eae5a07206b38f2c, type: 3}
        text: Sure. Let's give him another song to take home.
        avatars:
        - slot: 1
          sprite: {fileID: 1414087313690171253, guid: bd2e8b9a35e8b5740a210eeda43ff22c, type: 3}
        - slot: 4
          sprite: {fileID: 4067148055806570340, guid: 63bc681a22b302b4697f4c06ebb49c41, type: 3}
  - opponent: 4
    deckDescription: Meiko creates new cards and shares keywords to strengthen her
      performers.
    location: The Converted Cinema
    auditionText: An audition against MEIKO.
    firstClearReward: {fileID: 11400000, guid: 4dcfa479a1bb07c4c93f10a503340161, type: 2}
    easyDeck: {fileID: 11400000, guid: 066951dfb2fabf738bf0d86706f3ce72, type: 2}
    mediumDeck: {fileID: 11400000, guid: 667cedfedc6bc5f803e6556c38c79a7f, type: 2}
    hardDeck: {fileID: 11400000, guid: 25f74ba3e4be98bdaac0713570db66b4, type: 2}
    before:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        voiceline: {fileID: 8300000, guid: 745a7f666834c3e4da40c0b7d9a887f9, type: 3}
        text: MEIKO pins a full set list over a poster advertising fifteen-second
          song previews.
        avatars:
        - slot: 1
          sprite: {fileID: -772454078125462199, guid: c27636dc5f7cbbb468012701b90daea9, type: 3}
        - slot: 4
          sprite: {fileID: 1025957635999731651, guid: e299bec22c3e3b04ca06e0001ac7ca64, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: ebea650ba54e39342a2907330c193e29, type: 3}
        text: Are the previews really only fifteen seconds?
        avatars:
        - slot: 1
          sprite: {fileID: -2199009814668414564, guid: 25eb3c64c8a9d4e4dbac7f14ab53122f, type: 3}
        - slot: 4
          sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - speaker: MEIKO
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 101f799527d7515428e83feb2ebee1bd, type: 3}
        text: That's what the organizers asked for.
        avatars:
        - slot: 1
          sprite: {fileID: 1414087313690171253, guid: bd2e8b9a35e8b5740a210eeda43ff22c, type: 3}
        - slot: 4
          sprite: {fileID: 659807028895115265, guid: d5deaaf6772957344b6b32b1640b27d3, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: That's barely enough for my intro!
        avatars:
        - slot: 1
          sprite: {fileID: -2199009814668414564, guid: 25eb3c64c8a9d4e4dbac7f14ab53122f, type: 3}
        - slot: 4
          sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - speaker: MEIKO
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 521fde1548eb6db4b91752ddfa873053, type: 3}
        text: Then maybe the intro needs some editing.
        avatars:
        - slot: 1
          sprite: {fileID: 1414087313690171253, guid: bd2e8b9a35e8b5740a210eeda43ff22c, type: 3}
        - slot: 4
          sprite: {fileID: -5909369726638379594, guid: 15b288373541ce745b2a4fc354c46beb, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 08418d4e896d8934c8dcd6cea684ac65, type: 3}
        text: Hey! I worked hard on it!
        avatars:
        - slot: 1
          sprite: {fileID: 954787963642399000, guid: c3b010e893f41c4459071fb3aefecd76, type: 3}
        - slot: 4
          sprite: {fileID: 1025957635999731651, guid: e299bec22c3e3b04ca06e0001ac7ca64, type: 3}
    after:
      lines:
      - speaker: Narrator
        portrait: {fileID: 0}
        voiceline: {fileID: 8300000, guid: 1a07c2061a74d1e458acf4b765d7ca82, type: 3}
        text: The applause is still going when Miku returns to the side of the stage.
        avatars:
        - slot: 1
          sprite: {fileID: 531467281934478826, guid: b5204f013456e4745a67aceb894cb700, type: 3}
        - slot: 4
          sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: I thought that quiet part was going to lose them.
        avatars:
        - slot: 1
          sprite: {fileID: -6467469513183496125, guid: 64258669bcda46446a650c15765c381a, type: 3}
        - slot: 4
          sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - speaker: MEIKO
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 521fde1548eb6db4b91752ddfa873053, type: 3}
        text: You looked ready to skip it.
        avatars:
        - slot: 1
          sprite: {fileID: 4311828083851245686, guid: 0ed4ac1d21af8974a8e3b903b5a7c0c3, type: 3}
        - slot: 4
          sprite: {fileID: 659807028895115265, guid: d5deaaf6772957344b6b32b1640b27d3, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: I almost did.
        avatars:
        - slot: 1
          sprite: {fileID: -6467469513183496125, guid: 64258669bcda46446a650c15765c381a, type: 3}
        - slot: 4
          sprite: {fileID: -5024050331173424593, guid: 958fcfd1579699b4f92d3293e00f0594, type: 3}
      - speaker: MEIKO
        portrait: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 0}
        text: Glad you didn't. It was my favorite part.
        avatars:
        - slot: 1
          sprite: {fileID: 4311828083851245686, guid: 0ed4ac1d21af8974a8e3b903b5a7c0c3, type: 3}
        - slot: 4
          sprite: {fileID: 1521368860836332526, guid: 18538c62a586e8e40880ac3a43b0ccca, type: 3}
      - speaker: Miku
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        voiceline: {fileID: 8300000, guid: 8422fad6a39eec94b996e1834c64cf92, type: 3}
        text: Really? ...Okay, that one's staying.
        avatars:
        - slot: 1
          sprite: {fileID: 5531041605552728420, guid: 8a62fd28134ed2841aa676a65b561ae9, type: 3}
        - slot: 4
          sprite: {fileID: 8756508170796686454, guid: d93bc75ba5d83d14f859334df5b225e0, type: 3}
  - opponent: 5
    deckDescription: Luka contests Center Stage and builds audience score to unlock
      discounts and stronger buffs.
    location: The Planetarium
    auditionText: An audition against Luka.
    firstClearReward: {fileID: 11400000, guid: 38a9db64453d91f43bb1644e0ca1d69b, type: 2}
    easyDeck: {fileID: 11400000, guid: ceb93133aa9561c6a872dab0cfa2c39e, type: 2}
    mediumDeck: {fileID: 11400000, guid: f4b2837e43d5e0cbd469618d517077ef, type: 2}
