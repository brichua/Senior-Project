  - opponent: 5
    deckDescription: "Answer a melody with an unknown writer."
    location: "The Planetarium"
    auditionText: "A shared musical mystery beneath the planetarium stars."
    firstClearReward: {fileID: 11400000, guid: 2a55cd481cf55c344bbc28b64e00e025, type: 2}
    easyDeck: {fileID: 11400000, guid: 672111fe4515472988b5c2aebc23cacc, type: 2}
    mediumDeck: {fileID: 11400000, guid: 672111fe4515472988b5c2aebc23cacc, type: 2}
    hardDeck: {fileID: 11400000, guid: 672111fe4515472988b5c2aebc23cacc, type: 2}
    before:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "Stars wheel across the planetarium dome. Luka holds a score with three sets of lyrics and no name."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Same melody. Three cities. Nobody claims it."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Maybe they're afraid it isn't finished."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Or somebody took their name off it."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Let's hear what they've left us."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
    after:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "A folded note waits at the stage door: 'For whoever sings it next.'"
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "An invitation? Or another clue?"
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Let's keep a place for its writer."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Luka"
        portrait: {fileID: 3078160648837955091, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "On your set list?"
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "They started the song. They deserve to hear the answer."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
