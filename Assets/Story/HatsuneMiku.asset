%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5dcffc070f2c7d45a208d446b2d3945, type: 3}
  m_Name: HatsuneMiku
  m_EditorClassIdentifier: Assembly-CSharp::VocaloidTCG.StoryData
  id: story-hatsunemiku
  tutorial: 0
  storyClass: 0
  header: "World Tour Auditions — An Unfinished Song"
  prologue:
    lines:
    - speaker: "Narrator"
      portrait: {fileID: 0}
      text: "The tour invitation lands on Miku's desk beside an unfinished song."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
    - speaker: "Narrator"
      portrait: {fileID: 0}
      text: "Its map is crowded with names of cities. Her score has room for more than one voice."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
    - speaker: "Miku"
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "Five auditions. One headline spot."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
    - speaker: "Miku"
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "I'll need a song worth taking all that way."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
    - speaker: "Miku"
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "And people who'll argue with me until it's right."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
    - speaker: "Narrator"
      portrait: {fileID: 0}
      text: "She packs the empty pages."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
  epilogue:
    lines:
    - speaker: "Narrator"
      portrait: {fileID: 0}
      text: "Under HEADLINER, the final screen shows Miku's name. Her notebook has five other signatures."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - slot: 1
        sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - slot: 2
        sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 3
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 4
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 5
        sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
    - speaker: "Rin"
      portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "They gave you the whole stage. Why are you marking out six places?"
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - slot: 1
        sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - slot: 2
        sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 3
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 4
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 5
        sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
    - speaker: "Miku"
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "Because this song needs all of us."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - slot: 1
        sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - slot: 2
        sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 3
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 4
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 5
        sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
    - speaker: "Rin"
      portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "You could have warned us."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - slot: 1
        sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - slot: 2
        sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 3
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 4
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 5
        sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
    - speaker: "Miku"
      portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      text: "Would you have said yes?"
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - slot: 1
        sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - slot: 2
        sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 3
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 4
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 5
        sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
    - speaker: "Narrator"
      portrait: {fileID: 0}
      text: "Rin takes the pencil and circles a place beside Miku's."
      avatars:
      - slot: 0
        sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
      - slot: 1
        sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - slot: 2
        sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 3
        sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 4
        sprite: {fileID: -9194733545542927407, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - slot: 5
        sprite: {fileID: 4524798547330926687, guid: 40cd35695bff9344abfe246d209e2605, type: 3}
  auditions:
  - opponent: 1
    deckDescription: "A melody with a name of its own."
    location: "The Rooftop Theatre"
    auditionText: "A rooftop performance against Len."
    firstClearReward: {fileID: 11400000, guid: 2c9bee9d08e838f4b8bac5071656c12a, type: 2}
    easyDeck: {fileID: 11400000, guid: d1c376575e622ba4ea509d93cd2ae101, type: 2}
    mediumDeck: {fileID: 11400000, guid: d1c376575e622ba4ea509d93cd2ae101, type: 2}
    hardDeck: {fileID: 11400000, guid: d1c376575e622ba4ea509d93cd2ae101, type: 2}
    before:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "The rooftop stage looks down on a thousand windows. Len keeps checking a folded KAITO concert ticket."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "One day, I want my name on a ticket beside his."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "What would your opening song sound like?"
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Let me show you."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
    after:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "Len turns the ticket over. On its blank back, he scribbles a stubborn little melody."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I kept trying to sound like him."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "That last phrase sounded like you."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Len"
        portrait: {fileID: -3029326035077730249, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Use it. But leave my name on it."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Deal."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1105883623488579341, guid: a7e3ec9e288c6bf43a914750d9febc6e, type: 3}
  - opponent: 2
    deckDescription: "Win over a crowd that already knows Rin."
    location: "The Tram Depot"
    auditionText: "A spirited challenge in an old tram depot."
    firstClearReward: {fileID: 11400000, guid: 5a4ca13c112bad64190b371a46fc13d9, type: 2}
    easyDeck: {fileID: 11400000, guid: 05c75a68ffcd49039f41d5c0a3b6d766, type: 2}
    mediumDeck: {fileID: 11400000, guid: 05c75a68ffcd49039f41d5c0a3b6d766, type: 2}
    hardDeck: {fileID: 11400000, guid: 05c75a68ffcd49039f41d5c0a3b6d766, type: 2}
    before:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "The old tram depot shakes with a bass test. Rin taps the railing until the sound crew taps back."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I've warmed up the crowd. Try to keep them."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "All of them?"
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Especially the ones who came for me."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I like a challenge."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    after:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "A whistle from the back starts a ragged encore. Rin whistles the answer before she catches herself."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Fine. That ending worked."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Was that you asking for an encore?"
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Rin"
        portrait: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I was correcting their timing."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Then help me keep it."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "Rin steals Miku's pencil and writes four sharp beats."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: 1730541596440252085, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
  - opponent: 3
    deckDescription: "Make a chorus carry beyond the broadcast."
    location: "The Harbor Stage"
    auditionText: "A harbor performance for a small crowd and a large stream."
    firstClearReward: {fileID: 11400000, guid: 6583a1897eee0d744add7bc99a893801, type: 2}
    easyDeck: {fileID: 11400000, guid: 67abe06bb10144adb820be6c188de4b8, type: 2}
    mediumDeck: {fileID: 11400000, guid: 67abe06bb10144adb820be6c188de4b8, type: 2}
    hardDeck: {fileID: 11400000, guid: 67abe06bb10144adb820be6c188de4b8, type: 2}
    before:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "On a harbor stage, a red camera light blinks. KAITO checks it twice, then faces the few occupied seats."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Small crowd. Big broadcast."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Which one are you singing to?"
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Both. I'd like them to remember where to find me."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Then don't let that camera steal the show."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
    after:
      lines:
      - speaker: "Narrator"
        portrait: {fileID: 0}
        text: "The camera goes dark. Beyond the fence, a dockworker is still singing KAITO's chorus."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "The stream ended. I thought everyone had gone."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Someone kept your song."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "KAITO"
        portrait: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "Ask him to join us for the next one."
        avatars:
        - slot: 0
          sprite: {fileID: -7791428039026505738, guid: 08905605c3140264fb3ffcbf0dee90dc, type: 3}
        - slot: 5
          sprite: {fileID: -2876897028097707340, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
      - speaker: "Miku"
        portrait: {fileID: 855061685892153893, guid: 29b6669444f918e4ead6af724b83a075, type: 3}
        text: "I'll save him a part."
